{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cicada-cinema",
  "compatibility_date": "2025-12-19",
  // `disable_nodejs_process_v2` works around a known Astro/Cloudflare bug
  // where on-demand (non-prerendered) routes respond with the literal body
  // "[object Object]" when `nodejs_compat` is enabled without it — see
  // https://github.com/withastro/astro/issues/14511
  "compatibility_flags": ["nodejs_compat", "disable_nodejs_process_v2"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "kv_namespaces": [
    { "binding": "SESSION", "id": "161f170c4d6a456c8bf56bf57d8b9ef1" },
  ],
}
