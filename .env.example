# StudioCMS environment variables.
# Copy to `.env` (and `.dev.vars` for `wrangler dev`) and fill in.

# libSQL connection. Server routes run inside workerd (both `astro dev` and
# deployed), where @libsql/client speaks only http/ws — a `file:` database is
# unreachable. Run `pnpm db:serve` for a local server, or point this at Turso.
CMS_LIBSQL_URL=http://127.0.0.1:8080
# Plain http needs TLS explicitly turned off; the driver defaults it to true.
CMS_LIBSQL_TLS=false
# CMS_LIBSQL_AUTH_TOKEN=

# Auth encryption key: openssl rand --base64 16
CMS_ENCRYPTION_KEY=
