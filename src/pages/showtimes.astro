---
export const prerender = false;

import { Banner } from "@/components/Banner";
import { PageBreadcrumb } from "@/components/PageBreadcrumb";
import { ShowtimesGrid } from "@/components/ShowtimesGrid";
import Layout from "../layouts/Layout.astro";
import { getScreeningMovies } from "@/lib/square";

const movies = await getScreeningMovies();
---

<Layout title="Showtimes | Cicada Cinema">
  <Banner />
  <div class="max-w-3xl mx-auto px-6 pt-6">
    <PageBreadcrumb items={[{ label: "Showtimes" }]} />
  </div>
  <section class="max-w-3xl mx-auto px-6 py-16">
    <h1 class="text-4xl font-bold mb-6">Now Showing at Cicada Cinema</h1>
    <ShowtimesGrid client:load movies={movies} />
  </section>
</Layout>
