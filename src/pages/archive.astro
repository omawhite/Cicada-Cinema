---
import { Banner } from "@/components/Banner";
import { PageBreadcrumb } from "@/components/PageBreadcrumb";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Archive | Cicada Cinema">
  <Banner />
  <div class="max-w-3xl mx-auto px-6 pt-6">
    <PageBreadcrumb items={[{ label: "Archive" }]} />
  </div>
  <section class="max-w-3xl mx-auto px-6 py-16">
    <h1 class="text-4xl font-bold mb-6">Archive</h1>
    <p>See All the Past films Cicada Cinema has Screened so far!</p>
  </section>
</Layout>
