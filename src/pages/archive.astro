---
export const prerender = true;

import { Banner } from "@/components/Banner";
import { PageBreadcrumb } from "@/components/PageBreadcrumb";
import Layout from "../layouts/Layout.astro";
import { ScreeningsArchiveTable } from "@/components/ScreeningsArchiveTable";
import { fetchArchivedScreenings } from "@/lib/fetch-archived-screenings";

const SHEET_CSV_URL =
  "https://docs.google.com/spreadsheets/d/e/2PACX-1vTN-AzL_G0r3J282koHwLLfCNYcvyV-TcBM9oGgYKI62pvLK8vhUd-dc5IVrAjrogWgbdoJqbHnhiM9/pub?gid=18966700&single=true&output=csv";

const screenings = await fetchArchivedScreenings(SHEET_CSV_URL);
---

<Layout title="Archive | Cicada Cinema">
  <Banner />
  <div class="max-w-3xl mx-auto px-6 pt-6">
    <PageBreadcrumb items={[{ label: "Archive" }]} />
  </div>
  <section class="max-w-3xl mx-auto px-6 py-16">
    <h1 class="text-4xl font-bold mb-6">Archive</h1>
    <p>See All the Past films Cicada Cinema has Screened so far!</p>
  </section>
  <section class="px-6 py-8">
    <ScreeningsArchiveTable screenings={screenings} client:load />
  </section>
</Layout>
