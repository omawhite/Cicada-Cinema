---
import { Banner } from "@/components/Banner";
import { PageBreadcrumb } from "@/components/PageBreadcrumb";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Our Mission | Cicada Cinema">
  <Banner />
  <div class="max-w-3xl mx-auto px-6 pt-6">
    <PageBreadcrumb items={[{ label: "Our Mission" }]} />
  </div>
  <section class="max-w-3xl mx-auto px-6 py-16">
    <h1 class="text-4xl font-bold mb-6">Our Mission</h1>
    <p class="mb-4 leading-relaxed">
      Cicada Cinema is a nonprofit movie theater in Bloomington, IN. Our mission is to provide high-quality screenings of underrepresented cinema - the old, the new, and the locally created. Volunteer run and community driven, Cicada Cinema aims to create an independent space for film and film lovers.
    </p>
  </section>
</Layout>
