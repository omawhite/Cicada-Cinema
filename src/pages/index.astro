---
import { Banner } from "@/components/Banner";
import { NewsletterSignup } from "@/components/NewsletterSignup";
import { PageBreadcrumb } from "@/components/PageBreadcrumb";
import Layout from "../layouts/Layout.astro";
import { Button } from "@/components/ui/button";
---

<Layout>
  <Banner />
  <div class="max-w-3xl mx-auto px-6 pt-6">
    <PageBreadcrumb items={[{ label: "Home" }]} />
  </div>
  <section class="max-w-3xl mx-auto px-6 py-16">
    <h1 class="text-4xl font-bold mb-6">
      Cicada Cinema is opening a movie theater!
    </h1>
    <p>
      {`We're opening a physical, community movie theater on Bloomington's near
      west side. Our fundraising campaign may be over, but you can still donate
      to support Cicada Cinema! Please send checks to 818 W 6th St, Bloomington,
      IN 47404 or you can donate online using `}
      <a
        href="https://www.paypal.com/donate/?cmd=_donations&business=donate@cicadacinema.com"
        target="_blank"
        rel="noopener noreferrer"
      >
        PayPal
      </a>{" "}
      {`(donate@cicadacinema.com) or `}
      <a
        href="https://venmo.com/u/cicada_cinema"
        target="_blank"
        rel="noopener noreferrer"
      >
        Venmo
      </a>
      {` (@cicada_cinema).`}
    </p>

    <Button variant="default" className="mt-6 flex mx-auto w-fit">
      <a
        href="https://www.patronicity.com/project/cicada_cinema__bloomingtons_new_movie_theater"
        class="text-white no-underline"
      >
        Learn More About the campaign
      </a>
    </Button>
  </section>

  <section class="bg-black">
    <NewsletterSignup client:load />
  </section>

  <section class="max-w-3xl mx-auto px-6 py-16 space-y-4">
    <h2 class="text-2xl font-semibold">Unique movie-going experiences</h2>
    <p class="mb-4 leading-relaxed">
      Cicada Cinema is a nonprofit movie theater in Bloomington, IN. Our mission
      is to provide high-quality screenings of underrepresented cinema - the
      old, the new, and the locally created. Volunteer run and community driven,
      Cicada Cinema aims to create an independent space for film and film
      lovers.
    </p>
  </section>
</Layout>
