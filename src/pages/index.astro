---
import { Banner } from "@/components/Banner";
import { NewsletterSignup } from "@/components/NewsletterSignup";
import { PageBreadcrumb } from "@/components/PageBreadcrumb";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <Banner />
  <div class="max-w-3xl mx-auto px-6 pt-6">
    <PageBreadcrumb items={[{ label: "Home" }]} />
  </div>
  <section class="max-w-3xl mx-auto px-6 py-16">
    <h1 class="text-4xl font-bold mb-6">
      Cicada Cinema is opening a movie theater!
    </h1>
    <p>
      We're opening a physical, community movie theater on Bloomington's
      northwest side, and we need your help! Click the button below to learn
      more about the new theater and how you can provide support.
    </p>
  </section>

  <section class="bg-black">
    <NewsletterSignup client:load />
  </section>

  <section class="max-w-3xl mx-auto px-6 py-16 space-y-4">
    <h2 class="text-2xl font-semibold">Unique movie-going experiences</h2>
    <p class="mb-4 leading-relaxed">
      Cicada Cinema is a nonprofit movie theater in Bloomington, IN. Our mission
      is to provide high-quality screenings of underrepresented cinema - the
      old, the new, and the locally created. Volunteer run and community driven,
      Cicada Cinema aims to create an independent space for film and film
      lovers.
    </p>
  </section>
</Layout>
