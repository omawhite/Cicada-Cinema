---
import { Banner } from "@/components/Banner";
import { PageBreadcrumb } from "@/components/PageBreadcrumb";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact Us | Cicada Cinema">
  <Banner />
  <div class="max-w-3xl mx-auto px-6 pt-6">
    <PageBreadcrumb items={[{ label: "Contact Us" }]} />
  </div>
  <section class="max-w-3xl mx-auto px-6 py-16">
    <h1 class="text-4xl font-bold mb-6">Send us a message!</h1>
    <p class="mb-4 leading-relaxed">cicadacinema@gmail.com</p>
  </section>
</Layout>
